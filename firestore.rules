rules_version = '2';
// 1915 Field Leader App. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function userDoc() { return /databases/$(database)/documents/users/$(me()); }
    function rostered() { return signedIn() && exists(userDoc()); }
    function role() { return get(userDoc()).data.role; }
    // The owner is always an admin (matches OWNER_EMAIL in config.js).
    function isAdmin() { return (signedIn() && me() == 'fpina@1915south.com') || (rostered() && role() == 'admin'); }
    function ownsIt() { return rostered() && (role() == 'leader' || role() == 'director') && request.resource.data.email == me() && (resource == null || resource.data.email == me()); }

    match /users/{email} {
      allow read: if rostered() || (signedIn() && email == me());
      allow write: if isAdmin();
    }
    match /config/{doc} { allow read: if rostered(); allow write: if isAdmin(); }
    match /daily/{date} { allow read: if rostered(); allow write: if isAdmin(); }
    match /rsa/{doc}    { allow read: if rostered(); allow write: if isAdmin(); }
    match /plans/{id}   { allow read: if rostered(); allow create, update: if isAdmin() || ownsIt(); allow delete: if isAdmin(); }
    match /visits/{id}  { allow read: if rostered(); allow create, update: if isAdmin() || ownsIt(); allow delete: if isAdmin(); }
    match /photos/{id}  { allow read: if rostered(); allow create, update: if isAdmin() || ownsIt(); allow delete: if isAdmin() || (rostered() && resource.data.email == me()); }
    match /timeoff/{id} { allow read: if rostered(); allow create, update: if isAdmin() || ownsIt(); allow delete: if isAdmin(); }
  }
}
